{
  "name": "qlicker-server",
  "version": "1.0.0",
  "description": "Qlicker Fastify backend server",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "monitor": "node src/systemMonitor.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "migrate:question-types": "node scripts/migrate-question-types.js",
    "migrate:question-types:apply": "node scripts/migrate-question-types.js --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@azure/storage-blob": "^12.34.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@node-rs/argon2": "^2.2.2",
    "@node-saml/node-saml": "^5.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "file-type": "^22.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@fastify/static": "10.1.6",
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion": "5.0.12",
    "fast-xml-parser": ">=5.7.0",
    "follow-redirects": "1.16.0",
    "yaml": "2.8.3"
  }
}
