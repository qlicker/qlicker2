# =============================================================================
# Qlicker Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Run ./setup.sh for an interactive setup that generates this file.
# =============================================================================

# --- Domain & TLS -----------------------------------------------------------
# The fully qualified domain name for your Qlicker instance.
DOMAIN=qlicker.example.com

# Paths to operator-provided TLS certificate and private key (PEM format),
# mounted into the nginx container. Only used when CERTBOT_AUTORENEW=false
# (or as fallback before the first Let's Encrypt issuance).
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
# true = certificates are managed by Let's Encrypt: nginx serves them directly
# from the shared certbot volume and reloads automatically when the certbot
# container renews them. Run ./setup.sh --init-certs for the first issuance
# (it sets this to true). false = use the TLS_CERT_PATH/TLS_KEY_PATH files.
CERTBOT_AUTORENEW=false
# How often (seconds) nginx checks whether the active certificate changed.
#TLS_RELOAD_CHECK_SECONDS=60

# Optional image overrides for the app services.
SERVER_IMAGE=qlicker/qlicker-server:latest
CLIENT_IMAGE=qlicker/qlicker-client:latest
# Runtime version label baked into the application UI. The setup script uses
# the repository VERSION value; replace this placeholder when copying manually.
APP_VERSION=latest

# --- Scaling -----------------------------------------------------------------
# Number of API server replicas for load balancing.
# Recommended: 2–4 for most deployments (each handles ~500 concurrent WS).
SERVER_REPLICAS=2

# --- Secrets -----------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional key for anonymous-session pseudonyms. When empty, JWT_SECRET is used.
# Before rotating JWT_SECRET while anonymous sessions are open or reviewable,
# set this to the current JWT_SECRET so students stay linked to their answers
# (setup.sh does this automatically when it regenerates JWT_SECRET).
ANONYMOUS_SESSION_SECRET=

# --- Database ----------------------------------------------------------------
# Built-in MongoDB admin credentials (required when using the bundled mongo service).
MONGO_INITDB_ROOT_USERNAME=qlickerAdmin
MONGO_INITDB_ROOT_PASSWORD=
# Internal MongoDB URI used by the server containers.
# Keep this in sync with the MongoDB admin credentials above.
# Example: mongodb://qlickerAdmin:<password>@mongo:27017/qlicker?authSource=admin
MONGO_URI=
# Conservative Mongo cache default for smaller hosts; increase on larger boxes.
MONGO_WIREDTIGER_CACHE_SIZE_GB=0.25
# App-side Mongo connection tuning for bursty live-session traffic.
MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_RETRIES=6
MONGO_CONNECT_RETRY_DELAY_MS=2000

# --- Email -------------------------------------------------------------------
# SMTP URL for email verification and password reset.
# Format: smtp://user:password@smtp.example.com:587
MAIL_URL=

# --- Redis -------------------------------------------------------------------
# Built-in Redis password (required when using the bundled redis service).
REDIS_PASSWORD=
# Redis URL for multi-instance WebSocket pub/sub.
# Keep this in sync with REDIS_PASSWORD above.
# Example: redis://:<password>@redis:6379
REDIS_URL=

# --- System monitoring -------------------------------------------------------
# One host sample per minute; 7 days retained. Accepted interval: 30–300 seconds.
SYSTEM_MONITOR_SAMPLE_INTERVAL_SECONDS=60
# A user is active after an authenticated API request within this window (5–120).
SYSTEM_MONITOR_ACTIVE_WINDOW_MINUTES=15
# Optional comma-separated non-overlapping host interfaces, e.g. eno1.
# Blank prefers non-tunnel default routes to avoid VPN/uplink double counting.
# Missing explicit interfaces report unavailable network values; no silent fallback.
SYSTEM_MONITOR_NETWORK_INTERFACES=

# --- API port (internal) ----------------------------------------------------
# The port the Fastify server listens on inside the container.
# Nginx connects to this; it is NOT exposed to the host.
API_PORT=3001

# --- Backups -----------------------------------------------------------------
# Host directory where backup archives/logs are stored.
# You can point this to another disk, e.g. /data/qlicker2/backups
BACKUP_HOST_PATH=./backups

# Backup manager polling interval in seconds.
BACKUP_CHECK_INTERVAL_SECONDS=60

# Optional timezone override for the backup manager container.
# Set this to the deployment's local timezone if it differs from UTC.
TZ=UTC

# --- Misc --------------------------------------------------------------------
NODE_ENV=production
ROOT_URL=https://${DOMAIN}
# Keep the Swagger/OpenAPI UI disabled on internet-facing deployments unless
# you explicitly need it for operational troubleshooting.
ENABLE_API_DOCS=false
# Comma-separated IP/CIDR ranges for the reverse proxy that connects directly
# to Fastify. The bundled Docker deployment uses private bridge addresses.
# Use false when exposing the API directly. Numeric hop counts are unsupported.
TRUST_PROXY=loopback,linklocal,uniquelocal
# Load testing only: load-testing/run.sh sets this to true while a test runs
# and back to false afterwards. Keep false for normal operation.
DISABLE_RATE_LIMITS=false

# Comma-separated exact hostnames permitted for private-network AI backends.
# Production denies private-network targets by default. Add only a trusted
# internal model server's exact hostname (not a subnet) when one is required.
AI_BACKEND_ALLOW_PRIVATE_HOSTS=true
AI_BACKEND_ALLOWED_PRIVATE_HOSTS=
AI_BACKEND_REQUEST_TIMEOUT_MS=300000
